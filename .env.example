# GEL BLASTERS PT — Environment Variables
# Copia este ficheiro para .env e preenche os valores

# ---- Servidor ----
PORT=3000

# ---- Admin ----
ADMIN_PASSWORD=gelblasters2025   # Muda isto!
JWT_SECRET=                       # Gera com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Pagamentos Easypay (https://easypay.pt) ----
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=

# ---- Email (Gmail com App Password recomendado) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=                        # App Password do Gmail (não a password normal)
CONTACT_EMAIL=seuemail@gmail.com  # Email que recebe os contactos

# ---- Dados ----
DATA_FILE=./data/orders.json
