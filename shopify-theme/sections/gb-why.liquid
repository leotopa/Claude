{%- style -%}
.gb-why { padding: 80px 0; background: #0D0D1A; }
.gb-why__head { text-align: center; margin-bottom: 48px; }
.gb-why__sub { max-width: 560px; margin: 0 auto 48px; text-align: center; font-size: 1rem; color: #8A8AA8; }
.gb-why__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
  gap: 20px; max-width: 860px; margin: 0 auto;
}
.gb-why__card {
  background: #111120; border: 1px solid rgba(0,229,255,0.13);
  border-radius: 12px; padding: 28px 20px; text-align: center;
}
.gb-why__card-emoji { font-size: 2.2rem; margin-bottom: 12px; }
.gb-why__card-title { font-weight: 800; color: #fff; margin-bottom: 8px; font-size: .95rem; }
.gb-why__card-desc { font-size: .82rem; color: #8A8AA8; line-height: 1.55; }
{%- endstyle -%}

<section class="gb-why">
  <div class="page-width">
    <div class="gb-why__head">
      <div class="gb-section-label">{{ section.settings.label }}</div>
      <h2 class="gb-section-title" style="color:#fff;">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="gb-why__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="gb-why__grid">
      {%- for block in section.blocks -%}
        <div class="gb-why__card" {{ block.shopify_attributes }}>
          <div class="gb-why__card-emoji">{{ block.settings.emoji }}</div>
          <div class="gb-why__card-title">{{ block.settings.title }}</div>
          <div class="gb-why__card-desc">{{ block.settings.description }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GelBlasters — Porquê",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Porque é que toda a gente quer um?" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Diversão sem limites. Seguro. Sem confusões." },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "As bolas de gel dissolvem-se em contacto com a água. Sem manchas, sem limpeza. Só diversão pura com os teus amigos." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🎯" },
        { "type": "text", "id": "title", "label": "Título", "default": "Precisão Real" },
        { "type": "text", "id": "description", "label": "Descrição", "default": "Modo semi e automático. Alcance até 15 metros com as bolas de gel." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GelBlasters — Porquê",
      "blocks": [
        { "type": "card", "settings": { "emoji": "🎯", "title": "Precisão Real", "description": "Modo semi e automático. Alcance até 15 metros com as bolas de gel." } },
        { "type": "card", "settings": { "emoji": "👥", "title": "Para Grupos", "description": "Ideal para jogar em casa, jardim, ou partidas organizadas com amigos." } },
        { "type": "card", "settings": { "emoji": "⚡", "title": "Liga e Joga", "description": "Motor elétrico 7.4V já incluído. Carrega e está pronto em minutos." } }
      ]
    }
  ]
}
{% endschema %}
