{%- style -%}
.gb-steps { padding: 80px 0; background: #09090F; }
.gb-steps__head { text-align: center; margin-bottom: 40px; }
.gb-steps__grid {
  display: grid; grid-template-columns: 1fr; gap: 28px;
}
@media (min-width: 768px) { .gb-steps__grid { grid-template-columns: repeat(3,1fr); } }
.gb-step { display: flex; gap: 20px; align-items: flex-start; }
.gb-step__num {
  width: 52px; height: 52px; border-radius: 50%;
  background: rgba(0,229,255,0.12); border: 2px solid #00E5FF;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.2rem; font-weight: 900; color: #00E5FF; flex-shrink: 0;
}
.gb-step__content h3 { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 8px; }
.gb-step__content p { font-size: .85rem; color: #8A8AA8; line-height: 1.6; }
{%- endstyle -%}

<section class="gb-steps">
  <div class="page-width">
    <div class="gb-steps__head">
      <div class="gb-section-label">{{ section.settings.label }}</div>
      <h2 class="gb-section-title" style="color:#fff;">{{ section.settings.heading }}</h2>
    </div>
    <div class="gb-steps__grid">
      {%- for block in section.blocks -%}
        <div class="gb-step" {{ block.shopify_attributes }}>
          <div class="gb-step__num">{{ forloop.index }}</div>
          <div class="gb-step__content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GelBlasters — Como Funciona",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Simples e Rápido" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Em 3 Passos Tens o Teu" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Passo",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Escolhe o Modelo" },
        { "type": "text", "id": "description", "label": "Descrição", "default": "AK47, M416 ou MP5. Seleciona a cor que gostas mais e adiciona ao carrinho." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GelBlasters — Como Funciona",
      "blocks": [
        { "type": "step", "settings": { "title": "Escolhe o Modelo", "description": "AK47, M416 ou MP5. Seleciona a cor que gostas mais e adiciona ao carrinho." } },
        { "type": "step", "settings": { "title": "Preenche a Morada", "description": "Nome, morada e telefone. Paga por MB Way, Multibanco ou cartão. Seguro e rápido." } },
        { "type": "step", "settings": { "title": "Recebe em Casa", "description": "Entrega em Portugal continental. Já vem com tudo o que precisas para jogar." } }
      ]
    }
  ]
}
{% endschema %}
